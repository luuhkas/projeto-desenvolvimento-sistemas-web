// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Usuários do sistema (login/cadastro)
model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  senha    String
  papel    String   @default("OPERADOR")   // SUPER_ADMIN | ADMIN | OPERADOR
  criadoEm DateTime @default(now())
}

// Produtos do catálogo de estoque
model Produto {
  id         Int      @id @default(autoincrement())
  nome       String
  categoria  String
  quantidade Int      @default(0)
  minimo     Int      @default(0)
  criadoEm   DateTime @default(now())
  baixas     Baixa[]
}

// Baixas (saídas de estoque) — cada baixa pertence a um produto
model Baixa {
  id          Int      @id @default(autoincrement())
  quantidade  Int
  responsavel String
  data        DateTime @default(now())
  produtoId   Int
  produto     Produto  @relation(fields: [produtoId], references: [id])
}

// Convites para novos usuários (criados por um Admin/Super Admin)
model Convite {
  id        Int       @id @default(autoincrement())
  email     String
  token     String    @unique
  papel     String    @default("OPERADOR")
  expiraEm  DateTime
  usadoEm   DateTime?          // nulo = ainda não usado
  criadoPor String              // e-mail de quem convidou
  criadoEm  DateTime  @default(now())
}

// configuração da rotina de balanço diário (linha única, id = 1)
model RotinaConfig {
  id           Int      @id
  cron         String   @default("0 18 * * *") // balanço às 18h
  ativo        Boolean  @default(true)
  atualizadoEm DateTime @updatedAt
}