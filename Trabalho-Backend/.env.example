# Copie este arquivo para .env e ajuste os valores se necessário.

# Banco de dados SQLite (caminho relativo à pasta prisma/)
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os tokens JWT (troque por um valor próprio)
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio"

# Porta da API principal
PORT="8080"

# URL do front (para montar o link do convite)
APP_URL="http://localhost:3000"

# Microserviço de e-mail
EMAIL_SERVICE_URL="http://localhost:8000"

# Validade do convite (em horas)
CONVITE_VALIDADE_HORAS="48"
