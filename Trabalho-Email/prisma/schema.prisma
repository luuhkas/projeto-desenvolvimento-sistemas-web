generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// log de todos os e-mails disparados pelo sistema
model Email {
  id        Int      @id @default(autoincrement())
  para      String
  assunto   String
  corpo     String
  status    String   @default("enviado") // enviado | falhou
  erro      String?
  enviadoEm DateTime @default(now())
}
